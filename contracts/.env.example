# Season 3 auction contracts env. Copy to .env (mainnet) or .env.sepolia (rehearsal)
# and fill in. All real env files are gitignored; never commit secrets.

# Broadcaster key for every lifecycle script. REQUIRED - Base.s.sol has no fallback
# key and refuses to run without it. Must be the owner of the Panorama NFT + mint
# controller (and the auction, once deployed).
PRIVATE_KEY=

# RPC + verification (foundry.toml wires these into rpc_endpoints/etherscan; the
# shell ops scripts build their RPC URL from API_KEY_ALCHEMY too, unless RPC_URL
# overrides it).
API_KEY_ALCHEMY=
API_KEY_ETHERSCAN=

# Core contracts the auction mints against.
PANORAMA_NFT=
PANORAMA_MINT_CONTROLLER=

# Deploy config (DeployAuction.s.sol / DeployAuctionSepolia.s.sol).
PANORAMA_AUCTION_OWNER=
# Reserve price in wei; must be >= 0.1 ETH (the contract's MIN_RESERVE_PRICE floor) and a whole
# multiple of BID_TICK (0.001 ETH).
PANORAMA_AUCTION_RESERVE_PRICE=100000000000000000
# Minimum increment over the clearing floor, in bps (500 = 5%).
PANORAMA_AUCTION_MIN_INCREMENT_BPS=500
# Auction start as a unix timestamp; must be strictly in the future at deploy time.
# Season 3 opens 2026-10-19 17:00 UTC.
PANORAMA_AUCTION_START=1792429200
# Duration in seconds (default 86400 = 24h; bounds 1h-30d). Adjustable after deploy
# until the first bid via setSchedule(start, duration).
PANORAMA_AUCTION_DURATION=86400
# Proceeds split 58%/42% to A/B at settlement.
PANORAMA_PAYOUT_A=
PANORAMA_PAYOUT_B=

# Filled in after deploy; pins every lifecycle script (Settle/Cancel/RefundAll).
# Obtain the codehash independently (e.g. cast keccak of the deployed runtime code),
# do not just copy what a script prints.
PANORAMA_AUCTION_ADDRESS=
PANORAMA_AUCTION_RUNTIME_CODEHASH=
# PanoramaSeason3SignalController printed by DeployAuction. The forge scripts do not need it;
# auction-manifest.sh checks it against auction.signalController(), and bid-alert.sh reads
# signals from it (both fall back to auction.signalController() when unset).
PANORAMA_SIGNAL_CONTROLLER=

# Batch sizes for settlement/refund loops (SettleAuctionAtomic / RefundAllAuction), max 30.
# One finalize(30) settles all 30 winners for about 3.4M gas (about 7.0M if every winner
# burns its 100k refund stipend).
PANORAMA_FINALIZE_BATCH=30
PANORAMA_REFUND_BATCH=30

# ---------------------------------------------------------------------------------------------
# Ops tooling (scripts/*.sh). All optional; the values shown are the defaults.
# ---------------------------------------------------------------------------------------------

# Discord webhook for scripts/monitor-auction.sh and scripts/bid-alert.sh (alerts are skipped
# when unset).
DISCORD_WEBHOOK_URL=

# Full RPC URL for the shell scripts. Unset = Alchemy URL built from API_KEY_ALCHEMY for
# RPC_CHAIN (mainnet or sepolia).
# RPC_URL=
# RPC_CHAIN=mainnet
# Auction address for the shell scripts. Unset = PANORAMA_AUCTION_ADDRESS.
# AUCTION=

# monitor-auction.sh: RPC timeout, webhook timeouts, and where it keeps state between runs
# (default: $XDG_STATE_HOME or ~/.local/state, one file per auction address).
# RPC_TIMEOUT_SECONDS=15
# WEBHOOK_CONNECT_TIMEOUT_SECONDS=5
# WEBHOOK_MAX_TIME_SECONDS=10
# STATE_FILE=

# bid-alert.sh: longest signal excerpt posted to Discord, in characters, and an explicit signal
# controller (unset = PANORAMA_SIGNAL_CONTROLLER, then auction.signalController()).
# SIGNAL_MAX_CHARS=100
# SIGNAL_CONTROLLER=

# rpc-load-test.sh: models the frontend's read load against RPC_URL.
# RPC_LOAD_REQUESTS=1
# RPC_LOAD_CONCURRENCY=1
# RPC_LOAD_TIMEOUT_SECONDS=20
# RPC_LOAD_CONNECT_TIMEOUT_SECONDS=5
# RPC_LOAD_ENS_RESOLUTIONS=30
# RPC_LOAD_ENS_CONCURRENCY=10
# RPC_LOAD_DEPLOY_BLOCK=
# RPC_LOAD_SIGNAL_CONTROLLER=
# RPC_LOAD_ACCOUNT=0x0000000000000000000000000000000000000000
# RPC_LOAD_SYNTHETIC=0
# MULTICALL_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
# ENS_RESOLVER_ADDRESS=0xeeeeeeee14d718c2b47d9923deab1335e144eeee
