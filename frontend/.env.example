# Season 3 auction site env. Copy to .env.local and fill in. Real env files are gitignored;
# never commit secrets. NEXT_PUBLIC_* values are inlined into the browser bundle at build time,
# so nothing here may be a secret beyond an RPC key you are willing to expose.
# src/lib/env.ts validates the format of every value on each build.

# ---------------------------------------------------------------------------------------------
# Chain and contract
# ---------------------------------------------------------------------------------------------

# Chain: 1 (mainnet), 11155111 (sepolia), or 31337 (local anvil). Drives wagmi and every read.
NEXT_PUBLIC_CHAIN_ID=1

# The deployed Season 3 auction (PanoramaSeason3Auction). Unset = the site shows the pre-launch
# countdown to 2026-10-19 17:00 UTC instead of live bidding.
NEXT_PUBLIC_PANORAMA_AUCTION_ADDRESS=

# Block the auction was deployed at. Bounds the Won and SignalAttached log scans (standings,
# winners, signals). REQUIRED on production mainnet builds once an auction address is set.
NEXT_PUBLIC_AUCTION_DEPLOY_BLOCK=

# Panorama ERC-721. Format-checked only: the auction reads the NFT it mints from on-chain.
NEXT_PUBLIC_PANORAMA_NFT_ADDRESS=0x435BD9CF72C278c9bAD9655732a6724469c6D9Ff

# ---------------------------------------------------------------------------------------------
# Connections
# ---------------------------------------------------------------------------------------------

# Authenticated HTTPS RPC. REQUIRED on production mainnet builds once an auction address is set
# (without it every visitor rides rate-limited public RPCs). Unset = public fallback RPCs.
# ws/wss is not accepted; plain http only for localhost/127.0.0.1 on chain 31337.
NEXT_PUBLIC_RPC_URL=

# Server-only RPC for /api/day-auctions (the eight open days on Manifold: listings, bid history,
# ENS). Never inlined into the browser bundle. REQUIRED once those auctions are live: the bid
# history is an eth_getLogs over thousands of blocks, which public nodes refuse. Unset = the
# route answers 503 and logs why. There is no public fallback on purpose.
RPC_URL=

# WalletConnect project id (cloud.reown.com). REQUIRED on production mainnet builds once an
# auction address is set; without it mobile wallets cannot connect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------------------------
# Links (defaults shown; leave unset unless you need to override)
# ---------------------------------------------------------------------------------------------

# CDN for the share image (season3/season3-og-preview.webp) and the Season 1 / Season 2 card
# images. Production builds require an https *.panorama.garden host.
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.panorama.garden

# Block explorer for tx and address links. Must be the canonical Etherscan for chains 1 and
# 11155111. Unset = picked from NEXT_PUBLIC_CHAIN_ID.
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://etherscan.io

# Public source repo linked in the footer. Production builds require https://github.com/.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ygtdmn/panorama-season3

# ---------------------------------------------------------------------------------------------
# Build mode
# ---------------------------------------------------------------------------------------------

# Set to 1 on the real production deployment when not on Vercel, so the strict build checks
# above arm. Vercel production builds arm on their own (VERCEL_ENV=production, set by Vercel).
PANORAMA_PRODUCTION=

# Set to 1 to force the in-memory demo auction (dev and preview only; /?demo=1 also works off
# mainnet). A production build FAILS if this is set.
NEXT_PUBLIC_AUCTION_DEMO=

# ---------------------------------------------------------------------------------------------
# Tests only (pnpm test:e2e). Not needed to run the site.
# ---------------------------------------------------------------------------------------------

# Forge artifacts directory for the anvil e2e chain. Unset = ../contracts/out (run `forge build`
# there first).
# PANORAMA_FORGE_OUT=
