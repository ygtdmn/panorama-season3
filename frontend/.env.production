# Public build settings for production (vinext build / Cloudflare Workers Builds).
# Every NEXT_PUBLIC_ value ends up in the browser bundle, so nothing here is secret.
# The server secret RPC_URL lives on the Worker: cf workers secrets update.
# Copied from the Vercel panorama-season3 production settings.

NEXT_PUBLIC_AUCTION_DEMO=0
NEXT_PUBLIC_AUCTION_DEPLOY_BLOCK=26194409
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.panorama.garden
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_GITHUB_URL=https://github.com/ygtdmn/panorama-season3
NEXT_PUBLIC_PANORAMA_AUCTION_ADDRESS=0x1c23F9Aa8D45828be69FF107E9c4e650b7a1CCd7
NEXT_PUBLIC_PANORAMA_NFT_ADDRESS=0x435BD9CF72C278c9bAD9655732a6724469c6D9Ff
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=2197f7e20e6990a09f606a8590579839
# A keyless public node, as on Vercel. A local .env.local outranks this file in a local
# build, so a local deploy loads this file into the environment first (see CLAUDE.md).
NEXT_PUBLIC_RPC_URL=https://gateway.tenderly.co/public/mainnet
